    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
