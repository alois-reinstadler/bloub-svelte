{
  "name": "bloub-svelte",
  "version": "0.2.0",
  "type": "module",
  "description": "Svelte 5 port of the SVG recreation of the x.ai bot avatar.",
  "license": "MIT",
  "author": "Jérémy Perret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alois-reinstadler/bloub-svelte.git"
  },
  "homepage": "https://alois-reinstadler.github.io/bloub-svelte/",
  "bugs": "https://github.com/alois-reinstadler/bloub-svelte/issues",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "svelte",
    "morphing"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "pnpm check && pnpm build:lib && pnpm build:site",
    "build:lib": "svelte-package",
    "build:site": "vite build",
    "package": "pnpm build:lib && publint",
    "pack:check": "pnpm package && pnpm pack --dry-run",
    "prepack": "pnpm package",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "gsap": "^3.15.0",
    "happy-dom": "^20.11.2",
    "mediabunny": "^1.54.0",
    "publint": "0.3.24",
    "svelte": "^5.56.10",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
